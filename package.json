{
  "name": "gif-frame-extractor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/seo-build.mjs",
    "build:production": "vite build && node scripts/seo-build.mjs --production-domain",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/check-browser.mjs",
    "test:merger": "node scripts/check-merger-browser.mjs",
    "test:converter": "node scripts/check-converter-browser.mjs",
    "test:editor": "node scripts/check-editor-browser.mjs",
    "check:site": "node scripts/check-site.mjs",
    "deploy": "npm run build:production && npm run check:site -- --production-domain && wrangler pages deploy dist --project-name gifframeextractor --branch main",
    "test:localized-tools": "node scripts/check-localized-tools-browser.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "gifenc": "1.0.3"
  },
  "devDependencies": {
    "gifuct-js": "^2.1.2",
    "playwright": "1.63.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
